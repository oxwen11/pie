{
  "name": "pie",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "watch": "turbo watch dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run lint:check && pnpm run format:check && pnpm run typecheck",
    "clean": "turbo run clean && git clean -xdf node_modules dist .turbo",
    "bump": "pnpm taze",
    "sherif": "pnpm dlx sherif --fix",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks",
    "doctor": "turbo run doctor"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@getpie/oxlint": "workspace:*",
    "@getpie/verify": "workspace:*",
    "@oxlint/plugins": "1.81.0",
    "@types/node": "catalog:",
    "agent-cli-detector": "^0.1.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "^0.3.24",
    "simple-git-hooks": "^2.14.0",
    "taze": "^19.17.2",
    "tsdown": "catalog:",
    "tsx": "latest",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "^7.10.7",
    "unrun": "^0.3.1",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec turbo run build --filter=@getpie/oxlint --output-logs=errors-only && npx --no-install lint-staged"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
