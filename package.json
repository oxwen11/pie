{
  "name": "pie",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "watch": "turbo watch dev",
    "build": "turbo run build",
    "test": "vitest run && vitest run --config vitest.browser.config.mts",
    "test:watch": "vitest",
    "e2e": "turbo run e2e --concurrency=1",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run lint:check && pnpm run format:check && pnpm run typecheck",
    "clean": "turbo run clean && git clean -xdf node_modules dist .turbo",
    "bump": "pnpm taze",
    "sherif": "pnpm dlx sherif --fix",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks",
    "doctor": "turbo run doctor"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@getpie/oxlint": "workspace:*",
    "@getpie/verify": "workspace:*",
    "@oxlint/plugins": "1.86.0",
    "@shadcn/lint": "^0.1.5",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "agent-cli-detector": "^0.1.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "^1.63.0",
    "publint": "^0.3.24",
    "simple-git-hooks": "^2.14.0",
    "taze": "^19.17.2",
    "tsdown": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "^7.12.2",
    "unrun": "^0.3.1",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec turbo run build --filter=@getpie/oxlint --output-logs=errors-only && npx --no-install lint-staged"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
