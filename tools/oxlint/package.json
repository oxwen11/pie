    "test:watch": "vitest",
    "clean": "git clean -xdf node_modules dist .turbo"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "oxlint": "^1.80.0",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
