{
  "name": "@getpie/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./project": "./src/project/index.ts",
    "./events": "./src/events/index.ts",
    "./fs": "./src/fs/index.ts",
    "./git": "./src/git/index.ts",
    "./rpc": "./src/rpc/index.ts",
    "./http": "./src/http/index.ts",
    "./daemon": "./src/daemon/index.ts",
    "./observability": "./src/observability/index.ts",
    "./observability/resources": "./src/observability/resources/index.ts",
    "./resource-writer": "./dist/resources/writer-worker.mjs",
    "./pi-rpc": "./dist/pi-rpc/pi-rpc.js"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-resource-monitor.mjs && bun build src/harness/pi/rpc/entry.ts --target bun --outfile dist/pi-rpc/pi-rpc.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf node_modules dist .turbo"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@effect/platform-node": "catalog:effect",
    "@getpie/contract": "workspace:*",
    "@getpie/core": "workspace:*",
    "@getpie/effect-json-store": "workspace:*",
    "@orpc/experimental-effect": "catalog:orpc",
    "@orpc/server": "catalog:orpc",
    "ai": "catalog:",
    "effect": "catalog:effect",
    "node-pty": "1.1.0",
    "simple-git": "catalog:",
    "uuid": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect",
    "@getpie/typescript": "workspace:*",
    "@types/ws": "catalog:",
    "vitest": "catalog:"
  }
}
