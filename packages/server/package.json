{
  "name": "@getpie/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./project": "./src/project/index.ts",
    "./events": "./src/events/index.ts",
    "./fs": "./src/fs/index.ts",
    "./git": "./src/git/index.ts",
    "./rpc": "./src/rpc/index.ts",
    "./http": "./src/http/index.ts",
    "./daemon": "./src/daemon/index.ts",
    "./config/paths": "./src/config/paths.ts",
    "./observability": "./src/observability/index.ts",
    "./observability/resources": "./src/observability/resources/index.ts",
    "./resource-monitor": "./dist/resources/resource-monitor",
    "./pi-process": "./dist/pi-process/pi-process.js"
  },
  "scripts": {
    "build": "tsdown && bun --no-install build-pi-process.ts && node scripts/build-resource-monitor.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf node_modules dist .turbo"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@effect/platform-node": "catalog:effect",
    "@ff-labs/pi-fff": "0.10.6",
    "@getpie/contract": "workspace:*",
    "@getpie/core": "workspace:*",
    "@getpie/effect-json-store": "workspace:*",
    "@orpc/experimental-effect": "catalog:orpc",
    "@orpc/server": "catalog:orpc",
    "ai": "catalog:",
    "effect": "catalog:effect",
    "node-pty": "1.1.0",
    "simple-git": "catalog:",
    "uuid": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect",
    "@getpie/typescript": "workspace:*",
    "@types/ws": "catalog:",
    "vitest": "catalog:"
  }
}
