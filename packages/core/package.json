{
  "name": "@getpie/core",
  "version": "0.0.1",
  "private": true,
  "description": "Shared core types and process identity for Pie",
  "type": "module",
  "exports": {
    "./compatibility": {
      "types": "./dist/compatibility.d.ts",
      "default": "./dist/compatibility.js"
    },
    "./development-scope": {
      "types": "./dist/development-scope.d.ts",
      "default": "./dist/development-scope.js"
    },
    "./executable": {
      "types": "./dist/executable.d.ts",
      "default": "./dist/executable.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf node_modules dist .turbo"
  },
  "dependencies": {
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@getpie/typescript": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
