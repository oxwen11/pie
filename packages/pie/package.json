{
  "name": "@getpie/cli",
  "version": "0.0.1",
  "description": "Pie CLI — daemon and serve for the Pi coding agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxwen11/pie.git",
    "directory": "packages/pie"
  },
  "bin": {
    "pie": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "PIE_PORT=4180 tsx src/node/cli.ts serve",
    "build": "tsdown",
    "start": "node dist/cli.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p src/node",
    "clean": "git clean -xdf node_modules dist .turbo"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@effect/platform-node": "catalog:effect",
    "@orpc/contract": "catalog:orpc",
    "@orpc/server": "catalog:orpc",
    "ai": "catalog:",
    "effect": "catalog:effect",
    "uuid": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@getpie/server": "workspace:*",
    "@getpie/typescript": "workspace:*",
    "@types/ws": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
