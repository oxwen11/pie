{
  "name": "@getpie/cli",
  "version": "0.0.2",
  "description": "Pie CLI — daemon, serve, run, and a standalone relay hop for the Pi coding agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxwen11/pie.git",
    "directory": "packages/pie"
  },
  "bin": {
    "pie": "./dist/cli.mjs",
    "pie-relay": "./dist/relay.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./pi-process": "./dist/pi-process/pi-process.js",
    "./resource-monitor": "./dist/resources/resource-monitor"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "PIE_PORT=4180 tsx src/node/cli.ts serve",
    "build": "tsdown",
    "start": "node dist/cli.mjs",
    "publint": "publint",
    "prepublishOnly": "pnpm turbo run publint --filter=@getpie/cli",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p src/node",
    "clean": "git clean -xdf node_modules dist .turbo"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@effect/platform-node": "catalog:effect",
    "@effect/vitest": "catalog:effect",
    "@getpie/client": "workspace:*",
    "@getpie/contract": "workspace:*",
    "@getpie/core": "workspace:*",
    "@getpie/server": "workspace:*",
    "@getpie/typescript": "workspace:*",
    "@orpc/client": "catalog:orpc",
    "@orpc/contract": "catalog:orpc",
    "@orpc/server": "catalog:orpc",
    "@types/ws": "catalog:",
    "ai": "catalog:",
    "effect": "catalog:effect",
    "uuid": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
