{
  "name": "@getpie/contract",
  "version": "0.0.1",
  "private": true,
  "description": "RPC contract for Pie",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain.ts",
    "./fs": "./src/fs.ts",
    "./git": "./src/git.ts",
    "./project": "./src/project.ts",
    "./pull-request": "./src/pull-request.ts",
    "./session": "./src/session.ts",
    "./agent": "./src/agent.ts",
    "./session-events": "./src/session-events.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf node_modules dist .turbo"
  },
  "dependencies": {
    "@orpc/contract": "catalog:orpc",
    "@orpc/experimental-effect": "catalog:orpc",
    "ai": "catalog:",
    "effect": "catalog:effect",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect",
    "@getpie/typescript": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
