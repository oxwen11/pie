{
  "$schema": "https://turborepo.com/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "cn-build": {
      "inputs": ["src/**/*.{ts,tsx}", "../../apps/app/src/**/*.{ts,tsx}"],
      "outputs": ["src/lib/cn-tables.js"]
    },
    "typecheck": {
      "dependsOn": ["cn-build"]
    },
    "test": {
      "dependsOn": ["cn-build"]
    }
  }
}
