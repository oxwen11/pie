{
  "name": "@getpie/orpc-cli",
  "version": "0.0.1",
  "private": true,
  "description": "Opt-in Commander CLI over an implemented oRPC router",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect.ts"
  },
