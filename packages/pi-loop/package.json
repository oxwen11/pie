{
  "name": "@getpie/pi-loop",
  "version": "0.0.1",
  "private": true,
  "description": "Session-scoped /loop extension for a long-running Server Pi process",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf node_modules dist .turbo"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@getpie/typescript": "workspace:*",
    "typebox": "1.3.30",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
