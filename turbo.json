{
  "$schema": "https://turborepo.com/schema.v2.json",
  "globalDependencies": ["mise.toml", "mise.lock"],
  "globalEnv": ["CI"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": ["*"]
    },
    "preview": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "build": {
      "outputs": ["dist/**"],
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "cache": false,
      "dependsOn": ["@getpie/oxlint#build"]
    },
    "lint:check": {
      "cache": false,
      "dependsOn": ["@getpie/oxlint#build"]
    },
    "clean": {
      "cache": false
    },
    "doctor": {
      "cache": false
    }
  }
}
