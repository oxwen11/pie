#!/usr/bin/env bash
# Start an isolated pie web instance (foreground serve + Vite) for verification.

set -euo pipefail
# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

REPLACE=0
if [[ "${1:-}" == "--replace" ]]; then
  REPLACE=1
fi

verify_pie_use_node24
REPO="$(verify_pie_repo_root)"
PIE_PORT="${PIE_PORT:-${DEFAULT_PIE_PORT}}"

# @getpie/core exports dist/*.mjs only. Server/UI still resolve src/*.ts via tsx/Vite.
if [[ ! -f "${REPO}/packages/core/dist/compatibility.mjs" ]]; then
  echo "verify-pie: building @getpie/core (packages/core/dist missing)"
  (cd "${REPO}" && pnpm turbo run build --filter=@getpie/core)
fi

if ((PIE_PORT == 4000)); then
  echo "verify-pie: refuse PIE_PORT=4000 — that is the desktop daemon port (auth-token gated)." >&2
  exit 1
fi

if run_dir="$(verify_pie_current_run)"; then
  server_pid="$(verify_pie_read_pid "${run_dir}/pids/server.pid")"
  vite_pid="$(verify_pie_read_pid "${run_dir}/pids/vite.pid")"
  if verify_pie_pid_alive "${server_pid}" && verify_pie_pid_alive "${vite_pid}" &&
    verify_pie_http_ok "http://127.0.0.1:${PIE_PORT}/api/health" &&
    verify_pie_http_ok "http://127.0.0.1:${VITE_PORT}/api/health"; then
    echo "verify-pie: already running at ${run_dir}"
    echo "  app     http://127.0.0.1:${VITE_PORT}/"
    echo "  api     http://127.0.0.1:${PIE_PORT}/api/health"
    echo "  home    $(verify_pie_json_get "${run_dir}/meta.json" pieHome)"
    exit 0
  fi
  if verify_pie_pid_alive "${server_pid}" || verify_pie_pid_alive "${vite_pid}"; then
    if ((REPLACE == 1)); then
      "${VERIFY_PIE_BIN}/verify-pie-cleanup"
    else
      echo "verify-pie: a previous run still has live processes (${run_dir})." >&2
      echo "  run ${VERIFY_PIE_BIN}/verify-pie-cleanup or re-launch with --replace" >&2
      exit 1
    fi
  else
    echo "verify-pie: dropping stale run pointer ${run_dir}"
    rm -f "${CURRENT_LINK}"
  fi
fi

foreign_port() {
  local port="$1"
  local pids
  pids="$(verify_pie_listen_pids "${port}")"
  if [[ -n "${pids}" ]]; then
    echo "verify-pie: port ${port} is already taken by pid(s): ${pids}" >&2
    echo "  Vite is pinned to ${VITE_PORT} (strict). Two web instances cannot share it." >&2
    echo "  Do not drive a foreign pie / Vite — refuse rather than hijack." >&2
    return 1
  fi
}

foreign_port "${PIE_PORT}"
foreign_port "${VITE_PORT}"

RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
RUN_DIR="${VERIFY_ROOT}/runs/${RUN_ID}"
PIE_HOME="${RUN_DIR}/pie-home"
SAMPLE_DIR="${HOME}/${SAMPLE_PROJECT_NAME}"
mkdir -p "${RUN_DIR}/pids" "${RUN_DIR}/logs" "${PIE_HOME}"

created_sample=0
if [[ ! -e "${SAMPLE_DIR}" ]]; then
  mkdir -p "${SAMPLE_DIR}"
  cat >"${SAMPLE_DIR}/${SAMPLE_MARKER}" <<EOF
verify-pie scaffolding — safe to delete. Created so the import-project dialog
lists a distinctive folder at \$HOME without walking a long path.
EOF
  printf '%s\n' "sample project for pie verification" >"${SAMPLE_DIR}/README.md"
  created_sample=1
elif [[ ! -f "${SAMPLE_DIR}/${SAMPLE_MARKER}" ]]; then
  echo "verify-pie: ${SAMPLE_DIR} exists and is not our scaffold. Leaving it untouched." >&2
fi

cat >"${RUN_DIR}/meta.json" <<EOF
{
  "runId": "${RUN_ID}",
  "repo": "${REPO}",
  "pieHome": "${PIE_HOME}",
  "piePort": ${PIE_PORT},
  "vitePort": ${VITE_PORT},
  "appUrl": "http://localhost:${VITE_PORT}/",
  "sampleProject": "${SAMPLE_DIR}",
  "createdSample": ${created_sample},
  "startedAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

mkdir -p "${VERIFY_ROOT}/runs"
ln -sfn "${RUN_DIR}" "${CURRENT_LINK}"

# Foreground `pie serve`, not `pie` / daemon. Daemon binds 4000 and requires a token.
(
  cd "${REPO}/packages/pie"
  export PIE_PORT PIE_HOME
  export NODE_ENV=development
  exec pnpm dev
) >"${RUN_DIR}/logs/server.log" 2>&1 &
echo $! >"${RUN_DIR}/pids/server.pid"

wait_for() {
  local name="$1"
  local check="$2"
  local seconds="${3:-90}"
  local i
  for ((i = 0; i < seconds; i++)); do
    if eval "${check}"; then
      return 0
    fi
    sleep 1
  done
  echo "verify-pie: timed out waiting for ${name}" >&2
  echo "  last log lines:" >&2
  return 1
}

if ! wait_for "pie serve on ${PIE_PORT}" \
  "verify_pie_health_ok '${PIE_PORT}'" 60; then
  tail -n 40 "${RUN_DIR}/logs/server.log" >&2 || true
  verify_pie_copy_failure_logs "${RUN_DIR}"
  "${VERIFY_PIE_BIN}/verify-pie-cleanup" || true
  exit 1
fi

if ! grep -q 'pie:ready ' "${RUN_DIR}/logs/server.log"; then
  echo "verify-pie: /api/health is ok but the ready line never appeared — continuing" >&2
fi

(
  cd "${REPO}/apps/app"
  export PIE_PORT
  exec pnpm dev
) >"${RUN_DIR}/logs/vite.log" 2>&1 &
echo $! >"${RUN_DIR}/pids/vite.pid"

if ! wait_for "vite proxy on ${VITE_PORT}" \
  "verify_pie_health_ok '${VITE_PORT}'" 90; then
  tail -n 40 "${RUN_DIR}/logs/vite.log" >&2 || true
  verify_pie_copy_failure_logs "${RUN_DIR}"
  "${VERIFY_PIE_BIN}/verify-pie-cleanup" || true
  exit 1
fi

# Warm the TanStack router plugin so routeTree.gen.ts is current.
curl -fsS -o /dev/null --max-time 10 "http://localhost:${VITE_PORT}/" || true

echo "verify-pie: launched ${RUN_ID}"
echo "  app     http://localhost:${VITE_PORT}/   (Vite binds [::1]; do not use 127.0.0.1:${VITE_PORT})"
echo "  api     http://127.0.0.1:${PIE_PORT}/api/health"
echo "  home    ${PIE_HOME}"
echo "  sample  ${SAMPLE_DIR}"
echo "  logs    ${RUN_DIR}/logs"
echo "  doctor  ${VERIFY_PIE_BIN}/verify-pie-doctor"
