#!/usr/bin/env bash
# Create / write proof artifacts for the current run. Cleanup never deletes these.

set -euo pipefail
# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

usage() {
  cat <<'EOF'
Usage:
  verify-pie-evidence path
  verify-pie-evidence init
  verify-pie-evidence screenshot <name>
  verify-pie-evidence snapshot <name>
  verify-pie-evidence url
  verify-pie-evidence side-effects
  verify-pie-evidence note <text>
EOF
}

run_dir="$(verify_pie_current_run)" || {
  echo "verify-pie-evidence: no current run" >&2
  exit 1
}
run_id="$(verify_pie_json_get "${run_dir}/meta.json" runId)"
dest="$(verify_pie_evidence_dir_for "${run_id}")"

cmd="${1:-path}"
shift || true

case "${cmd}" in
  path)
    printf '%s\n' "${dest}"
    ;;
  init)
    mkdir -p "${dest}"
    cp "${run_dir}/meta.json" "${dest}/meta.json"
    "${VERIFY_PIE_BIN}/verify-pie-doctor" >"${dest}/doctor.txt"
    date -u +%Y-%m-%dT%H:%M:%SZ >"${dest}/created-at"
    printf '%s\n' "${dest}"
    ;;
  screenshot)
    name="${1:-screen}"
    mkdir -p "${dest}"
    if ! command -v agent-browser >/dev/null 2>&1; then
      echo "verify-pie-evidence: agent-browser is not on PATH" >&2
      exit 1
    fi
    agent-browser screenshot "${dest}/${name}.png"
    printf '%s\n' "${dest}/${name}.png"
    ;;
  snapshot)
    name="${1:-snapshot}"
    mkdir -p "${dest}"
    if ! command -v agent-browser >/dev/null 2>&1; then
      echo "verify-pie-evidence: agent-browser is not on PATH" >&2
      exit 1
    fi
    agent-browser snapshot >"${dest}/${name}.txt"
    printf '%s\n' "${dest}/${name}.txt"
    ;;
  url)
    mkdir -p "${dest}"
    if ! command -v agent-browser >/dev/null 2>&1; then
      echo "verify-pie-evidence: agent-browser is not on PATH" >&2
      exit 1
    fi
    agent-browser get url >"${dest}/url.txt"
    cat "${dest}/url.txt"
    ;;
  side-effects)
    mkdir -p "${dest}/side-effects"
    pie_home="$(verify_pie_json_get "${run_dir}/meta.json" pieHome)"
    if [[ -f "${pie_home}/storage/projects.json" ]]; then
      cp "${pie_home}/storage/projects.json" "${dest}/side-effects/projects.json"
    else
      echo "missing" >"${dest}/side-effects/projects.json.missing"
    fi
    if [[ -d "${pie_home}/storage/sessions" ]]; then
      find "${pie_home}/storage/sessions" -type f -name '*.json' | sort >"${dest}/side-effects/session-files.txt"
      mkdir -p "${dest}/side-effects/sessions"
      while IFS= read -r file; do
        [[ -n "${file}" ]] || continue
        rel="${file#"${pie_home}/storage/sessions/"}"
        mkdir -p "${dest}/side-effects/sessions/$(dirname "${rel}")"
        cp "${file}" "${dest}/side-effects/sessions/${rel}"
      done <"${dest}/side-effects/session-files.txt"
    else
      echo "no sessions dir" >"${dest}/side-effects/session-files.txt"
    fi
    printf '%s\n' "${dest}/side-effects"
    ;;
  note)
    mkdir -p "${dest}"
    printf '%s\n' "$*" >>"${dest}/notes.txt"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
