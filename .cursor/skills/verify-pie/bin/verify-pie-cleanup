#!/usr/bin/env bash
# Tear down the instance this run started. Never kills by process name.
# Evidence under .cursor/skills/verify-pie/evidence/ is left alone.

set -euo pipefail
# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

kill_tree() {
  local pid="$1"
  local child
  if [[ -z "${pid}" ]]; then
    return 0
  fi
  if command -v pgrep >/dev/null 2>&1; then
    for child in $(pgrep -P "${pid}" 2>/dev/null || true); do
      kill_tree "${child}"
    done
  fi
  if verify_pie_pid_alive "${pid}"; then
    kill -TERM "${pid}" 2>/dev/null || true
  fi
}

wait_dead() {
  local pid="$1"
  local i
  for ((i = 0; i < 20; i++)); do
    if ! verify_pie_pid_alive "${pid}"; then
      return 0
    fi
    sleep 0.25
  done
  if verify_pie_pid_alive "${pid}"; then
    kill -KILL "${pid}" 2>/dev/null || true
  fi
}

run_dir=""
if run_dir="$(verify_pie_current_run)"; then
  :
elif [[ -n "${1:-}" && -d "$1" ]]; then
  run_dir="$(readlink -f "$1")"
else
  echo "verify-pie: no current run to clean up"
  exit 0
fi

server_pid="$(verify_pie_read_pid "${run_dir}/pids/server.pid")"
vite_pid="$(verify_pie_read_pid "${run_dir}/pids/vite.pid")"

echo "verify-pie: stopping server pid=${server_pid:-none} vite pid=${vite_pid:-none}"
kill_tree "${vite_pid}"
kill_tree "${server_pid}"
wait_dead "${vite_pid}"
wait_dead "${server_pid}"

remove_scaffold() {
  local sample="$1"
  if [[ -n "${sample}" && -f "${sample}/${SAMPLE_MARKER}" ]]; then
    rm -rf "${sample}"
    echo "verify-pie: removed scaffolding ${sample}"
  fi
}

if [[ -f "${run_dir}/meta.json" ]]; then
  remove_scaffold "$(verify_pie_json_get "${run_dir}/meta.json" sampleProject || true)"
fi
# Failed earlier runs may have left the marker folder with createdSample=false.
remove_scaffold "${HOME}/${SAMPLE_PROJECT_NAME}"

# Scratch instance only. Evidence lives next to the skill and is not here.
if [[ "${run_dir}" == "${VERIFY_ROOT}/runs/"* ]]; then
  rm -rf "${run_dir}"
  echo "verify-pie: removed ${run_dir}"
fi

if [[ -L "${CURRENT_LINK}" ]]; then
  current="$(readlink -f "${CURRENT_LINK}" || true)"
  if [[ -z "${current}" || "${current}" == "${run_dir}" ]]; then
    rm -f "${CURRENT_LINK}"
  fi
fi

echo "verify-pie: cleanup done (evidence kept under ${VERIFY_PIE_SKILL}/evidence/)"
