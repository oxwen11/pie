#!/usr/bin/env bash
# Read-only: is the current verify-pie-cli instance worth driving?

set -euo pipefail
# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

fail() {
  echo "verify-pie-cli doctor: FAIL — $*" >&2
  exit 1
}

warn() {
  echo "verify-pie-cli doctor: WARN — $*" >&2
}

if ! run_dir="$(verify_pie_cli_current_run)"; then
  foreign="$(verify_pie_cli_listen_pids "${DEFAULT_PIE_PORT}")"
  if [[ -n "${foreign}" ]]; then
    fail "port ${DEFAULT_PIE_PORT} is live but this is not a verify-pie-cli run (no ${CURRENT_LINK}). Refuse to drive a shared ~/.pie instance."
  fi
  fail "no current run. Launch first: ${VERIFY_PIE_CLI_BIN}/verify-pie-cli-launch"
fi

meta="${run_dir}/meta.json"
[[ -f "${meta}" ]] || fail "missing ${meta}"

mode="$(verify_pie_cli_json_get "${meta}" mode)"
pie_home="$(verify_pie_cli_json_get "${meta}" pieHome)"
daemon_dir="$(verify_pie_cli_json_get "${meta}" daemonDir)"
pie_port="$(verify_pie_cli_json_get "${meta}" piePort)"
run_id="$(verify_pie_cli_json_get "${meta}" runId)"

[[ -d "${pie_home}" ]] || fail "PIE_HOME ${pie_home} is missing"
if [[ "${pie_home}" == "${HOME}/.pie" || "${pie_home}" == "${HOME}/.pie-dev" ]]; then
  fail "PIE_HOME is the shared default (${pie_home}). This skill only drives isolated homes."
fi

if [[ "${mode}" == "serve" ]]; then
  serve_pid="$(verify_pie_cli_read_pid "${run_dir}/pids/serve.pid")"
  verify_pie_cli_pid_alive "${serve_pid}" || fail "serve pid ${serve_pid} is not running"
  address="http://127.0.0.1:${pie_port}"
  verify_pie_cli_health_ok "${address}" || fail "${address}/api/health is not ok"
  ticket_status="$(curl -sS -o /tmp/verify-pie-cli-ticket.json -w '%{http_code}' --max-time 2 \
    -X POST "${address}/api/ws-ticket" || true)"
  if [[ "${ticket_status}" != "200" ]]; then
    fail "serve /api/ws-ticket returned ${ticket_status} (expected 200, no token)"
  fi
  echo "verify-pie-cli doctor: OK"
  echo "  run     ${run_id}"
  echo "  mode    serve"
  echo "  api     ${address}/api/health"
  echo "  home    ${pie_home}"
  echo "  serve   pid ${serve_pid}"
  echo "  ticket  /api/ws-ticket 200 (no token)"
  exit 0
fi

record="${daemon_dir}/daemon.pid"
[[ -f "${record}" ]] || fail "missing ${record}"

address="$(verify_pie_cli_daemon_field "${record}" address)"
daemon_pid="$(verify_pie_cli_daemon_field "${record}" pid)"
token="$(verify_pie_cli_daemon_field "${record}" token)"

verify_pie_cli_pid_alive "${daemon_pid}" || fail "daemon pid ${daemon_pid} is not running"
verify_pie_cli_health_ok "${address}" || fail "${address}/api/health is not ok"

anon_status="$(curl -sS -o /tmp/verify-pie-cli-ticket-anon.json -w '%{http_code}' --max-time 2 \
  -X POST "${address}/api/ws-ticket" || true)"
if [[ "${anon_status}" != "401" ]]; then
  fail "/api/ws-ticket without token returned ${anon_status} (expected 401 — 200 means you hit pie serve)"
fi

auth_status="$(curl -sS -o /tmp/verify-pie-cli-ticket-auth.json -w '%{http_code}' --max-time 2 \
  -X POST "${address}/api/ws-ticket" \
  -H "Authorization: Bearer ${token}" || true)"
if [[ "${auth_status}" != "200" ]]; then
  fail "/api/ws-ticket with record token returned ${auth_status} (expected 200)"
fi

recorded_port="$(node -e 'process.stdout.write(new URL(process.argv[1]).port)' "${address}")"
listen_pids="$(verify_pie_cli_listen_pids "${recorded_port}")"
[[ -n "${listen_pids}" ]] || fail "nothing listens on ${recorded_port} (from daemon.pid address)"

echo "verify-pie-cli doctor: OK"
echo "  run     ${run_id}"
echo "  mode    daemon"
echo "  api     ${address}/api/health"
echo "  home    ${pie_home}"
echo "  daemon  pid ${daemon_pid}"
echo "  ticket  anonymous 401 / bearer 200"
