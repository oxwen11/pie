#!/usr/bin/env bash
# Run the pie CLI against the current isolated verify-pie-cli home.

set -euo pipefail
# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

verify_pie_cli_use_node24
REPO="$(verify_pie_cli_repo_root)"

run_dir="$(verify_pie_cli_current_run)" || {
  echo "verify-pie-cli-run: no current run. Launch first." >&2
  exit 1
}

verify_pie_cli_apply_run_env "${run_dir}"
verify_pie_cli_tsx "${REPO}" "$@"
