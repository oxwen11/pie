#!/usr/bin/env bash
# Create / write proof artifacts for the current CLI run. Cleanup never deletes these.

set -euo pipefail
# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

usage() {
  cat <<'EOF'
Usage:
  verify-pie-cli-evidence path
  verify-pie-cli-evidence init
  verify-pie-cli-evidence curl
  verify-pie-cli-evidence note <text>
EOF
}

run_dir="$(verify_pie_cli_current_run)" || {
  echo "verify-pie-cli-evidence: no current run" >&2
  exit 1
}
run_id="$(verify_pie_cli_json_get "${run_dir}/meta.json" runId)"
dest="$(verify_pie_cli_evidence_dir_for "${run_id}")"

cmd="${1:-path}"
shift || true

case "${cmd}" in
  path)
    printf '%s\n' "${dest}"
    ;;
  init)
    mkdir -p "${dest}/logs"
    cp "${run_dir}/meta.json" "${dest}/meta.json"
    "${VERIFY_PIE_CLI_BIN}/verify-pie-cli-doctor" >"${dest}/doctor.txt"
    date -u +%Y-%m-%dT%H:%M:%SZ >"${dest}/created-at"
    if [[ -d "${run_dir}/logs" ]]; then
      cp -a "${run_dir}/logs/." "${dest}/logs/" || true
    fi
    daemon_dir="$(verify_pie_cli_json_get "${run_dir}/meta.json" daemonDir)"
    if [[ -f "${daemon_dir}/daemon.pid" ]]; then
      verify_pie_cli_redact_record "${daemon_dir}/daemon.pid" "${dest}/daemon.pid.redacted.json"
    fi
    printf '%s\n' "${dest}"
    ;;
  curl)
    mkdir -p "${dest}"
    mode="$(verify_pie_cli_json_get "${run_dir}/meta.json" mode)"
    if [[ "${mode}" == "serve" ]]; then
      address="http://127.0.0.1:$(verify_pie_cli_json_get "${run_dir}/meta.json" piePort)"
      {
        echo "GET ${address}/api/health"
        curl -sS --max-time 2 "${address}/api/health" || true
        echo
        echo "POST ${address}/api/ws-ticket (no token)"
        curl -sS -o /dev/null -w "status %{http_code}\n" --max-time 2 -X POST "${address}/api/ws-ticket" || true
      } >"${dest}/curl.txt"
    else
      record="$(verify_pie_cli_json_get "${run_dir}/meta.json" daemonDir)/daemon.pid"
      address="$(verify_pie_cli_daemon_field "${record}" address)"
      token="$(verify_pie_cli_daemon_field "${record}" token)"
      {
        echo "GET ${address}/api/health"
        curl -sS --max-time 2 "${address}/api/health" || true
        echo
        echo "POST ${address}/api/ws-ticket (no token)"
        curl -sS -o /dev/null -w "status %{http_code}\n" --max-time 2 -X POST "${address}/api/ws-ticket" || true
        echo "POST ${address}/api/ws-ticket (bearer)"
        curl -sS -o /dev/null -w "status %{http_code}\n" --max-time 2 \
          -X POST "${address}/api/ws-ticket" \
          -H "Authorization: Bearer ${token}" || true
      } >"${dest}/curl.txt"
    fi
    printf '%s\n' "${dest}/curl.txt"
    ;;
  note)
    mkdir -p "${dest}"
    printf '%s\n' "$*" >>"${dest}/notes.txt"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
