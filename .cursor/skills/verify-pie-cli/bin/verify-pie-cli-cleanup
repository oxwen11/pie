#!/usr/bin/env bash
# Tear down the instance this run started. Never kills by process name.
# Evidence under .cursor/skills/verify-pie-cli/evidence/ is left alone.

set -euo pipefail
# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

kill_tree() {
  local pid="$1"
  local child
  if [[ -z "${pid}" ]]; then
    return 0
  fi
  if command -v pgrep >/dev/null 2>&1; then
    for child in $(pgrep -P "${pid}" 2>/dev/null || true); do
      kill_tree "${child}"
    done
  fi
  if verify_pie_cli_pid_alive "${pid}"; then
    kill -TERM "${pid}" 2>/dev/null || true
  fi
}

wait_dead() {
  local pid="$1"
  local i
  for ((i = 0; i < 20; i++)); do
    if ! verify_pie_cli_pid_alive "${pid}"; then
      return 0
    fi
    sleep 0.25
  done
  if verify_pie_cli_pid_alive "${pid}"; then
    kill -KILL "${pid}" 2>/dev/null || true
  fi
}

run_dir=""
if run_dir="$(verify_pie_cli_current_run)"; then
  :
elif [[ -n "${1:-}" && -d "$1" ]]; then
  run_dir="$(readlink -f "$1")"
else
  echo "verify-pie-cli: no current run to clean up"
  exit 0
fi

verify_pie_cli_use_node24 || true
REPO="$(verify_pie_cli_repo_root)"
meta="${run_dir}/meta.json"
mode=""
if [[ -f "${meta}" ]]; then
  mode="$(verify_pie_cli_json_get "${meta}" mode || true)"
  verify_pie_cli_apply_run_env "${run_dir}"
fi

if [[ "${mode}" == "serve" ]]; then
  serve_pid="$(verify_pie_cli_read_pid "${run_dir}/pids/serve.pid")"
  echo "verify-pie-cli: stopping serve pid=${serve_pid:-none}"
  kill_tree "${serve_pid}"
  wait_dead "${serve_pid}"
else
  daemon_pid=""
  if [[ -n "${PIE_DAEMON_DIR:-}" && -f "${PIE_DAEMON_DIR}/daemon.pid" ]]; then
    daemon_pid="$(verify_pie_cli_daemon_field "${PIE_DAEMON_DIR}/daemon.pid" pid || true)"
  fi
  echo "verify-pie-cli: pie daemon stop (recorded pid=${daemon_pid:-none})"
  if [[ -n "${PIE_HOME:-}" ]]; then
    verify_pie_cli_tsx "${REPO}" daemon stop >"${run_dir}/logs/cli-stop.log" 2>&1 || true
    if [[ -f "${run_dir}/logs/cli-stop.log" ]]; then
      cat "${run_dir}/logs/cli-stop.log"
    fi
  fi
  if [[ -n "${daemon_pid}" ]] && verify_pie_cli_pid_alive "${daemon_pid}"; then
    echo "verify-pie-cli: daemon still alive after stop; killing recorded pid ${daemon_pid}"
    kill_tree "${daemon_pid}"
    wait_dead "${daemon_pid}"
  fi
fi

if [[ "${run_dir}" == "${VERIFY_ROOT}/runs/"* ]]; then
  rm -rf "${run_dir}"
  echo "verify-pie-cli: removed ${run_dir}"
fi

if [[ -L "${CURRENT_LINK}" ]]; then
  current="$(readlink -f "${CURRENT_LINK}" || true)"
  if [[ -z "${current}" || "${current}" == "${run_dir}" ]]; then
    rm -f "${CURRENT_LINK}"
  fi
fi

echo "verify-pie-cli: cleanup done (evidence kept under ${VERIFY_PIE_CLI_SKILL}/evidence/)"
