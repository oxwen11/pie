#!/usr/bin/env bash
# Start an isolated Pie Desktop (electron-vite + token daemon) for verification.

set -euo pipefail
# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

REPLACE=0
if [[ "${1:-}" == "--replace" ]]; then
  REPLACE=1
elif [[ -n "${1:-}" ]]; then
  echo "verify-pie-desktop-launch: unknown arg $1" >&2
  echo "  usage: verify-pie-desktop-launch [--replace]" >&2
  exit 2
fi

verify_pie_desktop_use_node24
REPO="$(verify_pie_desktop_repo_root)"
PIE_PORT="${PIE_PORT:-${DEFAULT_PIE_PORT}}"
CDP_PORT="${PIE_REMOTE_DEBUG_PORT:-${DEFAULT_CDP_PORT}}"
verify_pie_desktop_reserved_port "${PIE_PORT}"

if [[ ! -f "${REPO}/packages/server/dist/server.mjs" ]]; then
  echo "verify-pie-desktop: building @getpie/server (packages/server/dist/server.mjs missing)"
  (cd "${REPO}" && pnpm turbo run build --filter=@getpie/server)
fi

if [[ -z "${DISPLAY:-}" ]] && ! command -v xvfb-run >/dev/null 2>&1; then
  echo "verify-pie-desktop: no DISPLAY and no xvfb-run. Refuse to start Electron headless without a display." >&2
  exit 1
fi

if run_dir="$(verify_pie_desktop_current_run)"; then
  ev_pid="$(verify_pie_desktop_read_pid "${run_dir}/pids/electron-vite.pid")"
  record="${run_dir}/pie-home/daemon/daemon.pid"
  if verify_pie_desktop_pid_alive "${ev_pid}" && [[ -f "${record}" ]]; then
    address="$(verify_pie_desktop_daemon_field "${record}" address)"
    daemon_pid="$(verify_pie_desktop_daemon_field "${record}" pid)"
    if verify_pie_desktop_pid_alive "${daemon_pid}" &&
      verify_pie_desktop_health_ok "${address}" &&
      verify_pie_desktop_cdp_ok "$(verify_pie_desktop_json_get "${run_dir}/meta.json" cdpPort)"; then
      echo "verify-pie-desktop: already running at ${run_dir}"
      echo "  api     ${address}/api/health"
      echo "  cdp     http://127.0.0.1:$(verify_pie_desktop_json_get "${run_dir}/meta.json" cdpPort)/json/version"
      echo "  home    $(verify_pie_desktop_json_get "${run_dir}/meta.json" pieHome)"
      exit 0
    fi
  fi
  if verify_pie_desktop_pid_alive "${ev_pid}"; then
    if ((REPLACE == 1)); then
      "${VERIFY_PIE_DESKTOP_BIN}/verify-pie-desktop-cleanup"
    else
      echo "verify-pie-desktop: a previous run still has live processes (${run_dir})." >&2
      echo "  run ${VERIFY_PIE_DESKTOP_BIN}/verify-pie-desktop-cleanup or re-launch with --replace" >&2
      exit 1
    fi
  else
    echo "verify-pie-desktop: dropping stale run pointer ${run_dir}"
    rm -f "${CURRENT_LINK}"
  fi
fi

foreign_port() {
  local port="$1"
  local label="$2"
  local pids
  pids="$(verify_pie_desktop_listen_pids "${port}")"
  if [[ -n "${pids}" ]]; then
    echo "verify-pie-desktop: port ${port} (${label}) is already taken by pid(s): ${pids}" >&2
    echo "  Do not attach to a foreign desktop / daemon — refuse rather than hijack." >&2
    return 1
  fi
}

foreign_port "${PIE_PORT}" "daemon"
foreign_port "${CDP_PORT}" "CDP"

RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
RUN_DIR="${VERIFY_ROOT}/runs/${RUN_ID}"
PIE_HOME="${RUN_DIR}/pie-home"
PIE_DAEMON_DIR="${PIE_HOME}/daemon"
USER_DATA="$(verify_pie_desktop_user_data "${CDP_PORT}")"
SAMPLE_DIR="${HOME}/${SAMPLE_PROJECT_NAME}"
mkdir -p "${RUN_DIR}/pids" "${RUN_DIR}/logs" "${PIE_HOME}" "${PIE_DAEMON_DIR}"

created_sample=0
if [[ ! -e "${SAMPLE_DIR}" ]]; then
  mkdir -p "${SAMPLE_DIR}"
  cat >"${SAMPLE_DIR}/${SAMPLE_MARKER}" <<EOF
verify-pie-desktop scaffolding — safe to delete.
EOF
  printf '%s\n' "sample project for pie desktop verification" >"${SAMPLE_DIR}/README.md"
  created_sample=1
elif [[ ! -f "${SAMPLE_DIR}/${SAMPLE_MARKER}" ]]; then
  echo "verify-pie-desktop: ${SAMPLE_DIR} exists and is not our scaffold. Leaving it untouched." >&2
fi

export PIE_HOME PIE_DAEMON_DIR PIE_PORT
export PIE_REMOTE_DEBUG_PORT="${CDP_PORT}"
export NODE_ENV=development

cat >"${RUN_DIR}/meta.json" <<EOF
{
  "runId": "${RUN_ID}",
  "repo": "${REPO}",
  "pieHome": "${PIE_HOME}",
  "daemonDir": "${PIE_DAEMON_DIR}",
  "piePort": ${PIE_PORT},
  "cdpPort": ${CDP_PORT},
  "userData": "${USER_DATA}",
  "sampleProject": "${SAMPLE_DIR}",
  "createdSample": ${created_sample},
  "startedAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

mkdir -p "${VERIFY_ROOT}/runs"
ln -sfn "${RUN_DIR}" "${CURRENT_LINK}"

start_electron_vite() {
  cd "${REPO}/apps/desktop"
  exec pnpm exec electron-vite dev
}

if [[ -n "${DISPLAY:-}" ]]; then
  start_electron_vite >"${RUN_DIR}/logs/electron-vite.log" 2>&1 &
else
  xvfb-run -a bash -c '
    cd "$1"
    exec pnpm exec electron-vite dev
  ' -- "${REPO}/apps/desktop" >"${RUN_DIR}/logs/electron-vite.log" 2>&1 &
fi
echo $! >"${RUN_DIR}/pids/electron-vite.pid"

wait_for() {
  local name="$1"
  local check="$2"
  local seconds="${3:-120}"
  local i
  for ((i = 0; i < seconds; i++)); do
    if eval "${check}"; then
      return 0
    fi
    sleep 1
  done
  echo "verify-pie-desktop: timed out waiting for ${name}" >&2
  return 1
}

RECORD="${PIE_DAEMON_DIR}/daemon.pid"
if ! wait_for "daemon.pid" "[[ -f '${RECORD}' ]]" 90; then
  tail -n 80 "${RUN_DIR}/logs/electron-vite.log" >&2 || true
  verify_pie_desktop_copy_failure_logs "${RUN_DIR}"
  "${VERIFY_PIE_DESKTOP_BIN}/verify-pie-desktop-cleanup" || true
  exit 1
fi

ADDRESS="$(verify_pie_desktop_daemon_field "${RECORD}" address)"
DAEMON_PID="$(verify_pie_desktop_daemon_field "${RECORD}" pid)"

if ! wait_for "daemon health at ${ADDRESS}" "verify_pie_desktop_health_ok '${ADDRESS}'" 40; then
  tail -n 80 "${RUN_DIR}/logs/electron-vite.log" >&2 || true
  tail -n 40 "${PIE_HOME}/logs/pie.log" >&2 || true
  verify_pie_desktop_copy_failure_logs "${RUN_DIR}"
  "${VERIFY_PIE_DESKTOP_BIN}/verify-pie-desktop-cleanup" || true
  exit 1
fi

if ! wait_for "CDP on ${CDP_PORT}" "verify_pie_desktop_cdp_ok '${CDP_PORT}'" 40; then
  tail -n 80 "${RUN_DIR}/logs/electron-vite.log" >&2 || true
  verify_pie_desktop_copy_failure_logs "${RUN_DIR}"
  "${VERIFY_PIE_DESKTOP_BIN}/verify-pie-desktop-cleanup" || true
  exit 1
fi

node -e '
  const fs = require("node:fs");
  const [file, address, pid] = process.argv.slice(1);
  const data = JSON.parse(fs.readFileSync(file, "utf8"));
  data.address = address;
  data.daemonPid = Number(pid);
  fs.writeFileSync(file, JSON.stringify(data, null, 2) + "\n");
' "${RUN_DIR}/meta.json" "${ADDRESS}" "${DAEMON_PID}"

echo "verify-pie-desktop: launched ${RUN_ID}"
echo "  api     ${ADDRESS}/api/health"
echo "  cdp     http://127.0.0.1:${CDP_PORT}/json/version"
echo "  pid     electron-vite $(verify_pie_desktop_read_pid "${RUN_DIR}/pids/electron-vite.pid") daemon ${DAEMON_PID}"
echo "  home    ${PIE_HOME}"
echo "  sample  ${SAMPLE_DIR}"
echo "  logs    ${RUN_DIR}/logs"
echo "  doctor  ${VERIFY_PIE_DESKTOP_BIN}/verify-pie-desktop-doctor"
