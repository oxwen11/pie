    "compiler-cleanup": "error"
  },
  "surfaces": {
    "cli": { "includeTags": ["design"] },
    "prComment": { "includeTags": ["design"] },
    "score": { "includeTags": ["design"] },
    "ciFailure": { "includeTags": ["design"] }
  },
